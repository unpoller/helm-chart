{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Review every update. Pull requests do not run checks, so nothing automerges.",
      "matchPackageNames": ["*"],
      "automerge": false
    }
  ]
}
